{
  "name": "grindtimeski",
  "private": true,
  "description": "Killington Run: an arcade ski game on the real Killington terrain, trails and lifts",
  "scripts": {
    "build": "python3 tools/build.py",
    "bake": "sh tools/bake/run.sh",
    "test:shots": "node tools/test/screenshots.js",
    "test:autopilot": "node tools/test/autopilot.js",
    "test:lifttops": "node tools/test/lift-tops.js",
    "test:landings": "node tools/test/landings.js",
    "test:terrain": "node tools/test/terrain-steps.js",
    "test:poses": "node tools/test/skier-poses.js",
    "test:weather": "node tools/test/weather.js",
    "test:sfx": "node tools/test/sfx.js",
    "test:camera": "node tools/test/camera.js",
    "test:tiles": "node tools/test/tile-stream.js",
    "test:ghost": "node tools/test/ghost.js",
    "test:tris": "node tools/test/tris.js",
    "test:challenge": "node tools/test/challenge.js",
    "test:look": "node tools/test/look.js"
  },
  "devDependencies": {
    "playwright": "^1.49.0",
    "three": "0.128.0"
  }
}
